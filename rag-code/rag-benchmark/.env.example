# ==============================================================================
# rag-benchmark Environment Configuration Template
# ==============================================================================
# Spring Boot does not load .env files automatically. Export variables before
# running the service:
#   cp .env.example .env
#   set -a && source .env && set +a
#   mvn spring-boot:run
#
# All properties have defaults in src/main/resources/application.yml. Override
# only the variables required for your target execution environment.

# ------------------------------------------------------------------------------
# Model Provider Selection ("ollama" for local execution, "google-genai" for cloud)
# ------------------------------------------------------------------------------
SPRING_AI_MODEL_CHAT=ollama
SPRING_AI_MODEL_EMBEDDING=ollama

# ------------------------------------------------------------------------------
# Local Execution (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ------------------------------------------------------------------------------
# Cloud Execution (Google Cloud Vertex AI)
# ------------------------------------------------------------------------------
# Uses Application Default Credentials (gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT_ID=<your-gcp-project-id>
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_CHAT_MODEL=gemini-3.8-flash
GOOGLE_GENAI_EMBEDDING_MODEL=text-embedding-004

# ------------------------------------------------------------------------------
# PostgreSQL / pgvector (Optional; auto-configured by spring-boot-docker-compose)
# ------------------------------------------------------------------------------
# POSTGRES_DB=ragbenchmark
# POSTGRES_USER=ragbenchmark
# POSTGRES_PASSWORD=ragbenchmark

# ------------------------------------------------------------------------------
# Optimization Modules (M2–M4)
# ------------------------------------------------------------------------------
# M2: Semantic Re-ranking ("noop", "vertex", or "local")
RAG_RERANKER_PROVIDER=noop
RAG_RERANKER_MODEL=semantic-ranker-default-004
RAG_RERANKER_VERTEX_LOCATION=global
RAG_RERANKER_VERTEX_RANKING_CONFIG=default_ranking_config
# RAG_RERANKER_LOCAL_BASE_URL=http://localhost:8081

# M3: Prompt & Context Caching ("noop" or "google-genai")
RAG_PROMPT_CACHE_PROVIDER=noop
RAG_PROMPT_CACHE_MIN_TOKENS=4096
RAG_PROMPT_CACHE_TTL=300s
# RAG_PROMPT_CACHE_CHARS_PER_TOKEN=3.5
# RAG_PROMPT_CACHE_PREFIX=rag-bench-

# M4: Complexity-Based Model Routing ("noop", "classifier", or "oracle")
RAG_ROUTER_PROVIDER=noop

# Generation thinking token budget (0 disables reasoning tokens for lowest latency)
RAG_GENERATION_THINKING_BUDGET=0
