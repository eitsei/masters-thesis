# rag-benchmark local environment template.
#
# IMPORTANT: Unlike Node.js (dotenv) or Python (python-dotenv), Spring Boot does NOT
# read .env files natively. Copying this file to `.env` alone does nothing -- you
# must get these variables into the actual process environment yourself, e.g.:
#
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)
#   mvn spring-boot:run
#
# Alternatives:
#   - direnv: create a matching `.envrc` with `dotenv` in it and `direnv allow`.
#   - IDE run configuration: add these as environment variables on the Spring Boot
#     run/debug configuration (IntelliJ: Run > Edit Configurations > Environment
#     variables).
#
# Every variable below has a working default baked into application.yml, so for the
# default local Ollama path you can skip all of this and just run `mvn spring-boot:run`
# directly -- these only need to be set/exported when you want to override a default
# (e.g. switching to the Google GenAI cloud path).
#
# Database connection details are NOT listed here: spring-boot-docker-compose starts
# docker-compose.yml automatically and wires up the app's datasource for you. See
# README.md. The credentials docker-compose.yml creates the container with (not the
# same thing as the app's connection, which is auto-wired) default to
# ragbenchmark/ragbenchmark/ragbenchmark and can optionally be overridden here --
# Docker Compose auto-loads this same .env file:
# POSTGRES_DB=ragbenchmark
# POSTGRES_USER=ragbenchmark
# POSTGRES_PASSWORD=ragbenchmark


# ---------------------------------------------------------------------------------
# Provider switch -- selects which Spring AI auto-configuration is active.
# Change BOTH to "google-genai" to use the cloud (Gemini) path instead of local Ollama.
# ---------------------------------------------------------------------------------
SPRING_AI_MODEL_CHAT=ollama
SPRING_AI_MODEL_EMBEDDING=ollama


# ---------------------------------------------------------------------------------
# Ollama (local) -- requires Ollama running with these models pulled:
#   ollama pull gemma4:e2b
#   ollama pull nomic-embed-text
#
# WSL2 note: if Ollama runs on the Windows side rather than inside WSL2, localhost
# will NOT reach it. Point this at the WSL2 default gateway IP instead:
#   OLLAMA_BASE_URL=http://$(ip route show | grep default | awk '{print $3}'):11434
# (same mechanism many WSL2 setups use for OLLAMA_HOST in .bashrc -- check
# `echo $OLLAMA_HOST` if you already have that configured for the `ollama` CLI).
# ---------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma4:e2b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ---------------------------------------------------------------------------------
# Google GenAI (cloud, "AI Studio" / Gemini Developer API mode) -- used when
# SPRING_AI_MODEL_CHAT / SPRING_AI_MODEL_EMBEDDING above are set to "google-genai".
#
# IMPORTANT: leave GOOGLE_AI_API_KEY commented out (not "GOOGLE_AI_API_KEY=" with an
# empty value) until you have a real key. Spring's ${VAR:default} placeholder syntax
# only falls back to its default when the variable is entirely ABSENT from the
# environment -- an exported-but-empty value still counts as "present" and wins over
# the default. application.yml relies on that absence to supply a safe placeholder for
# the embedding connection (a Spring AI 2.0 quirk: see the comment there), so an
# empty-but-exported key here would break even the default local Ollama path.
# ---------------------------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=
GOOGLE_GENAI_CHAT_MODEL=gemini-3.7-flash
GOOGLE_GENAI_EMBEDDING_MODEL=gemini-embedding-001


# ---------------------------------------------------------------------------------
# Google GenAI (cloud, Vertex AI mode) -- an alternative to the API-key mode above,
# using GCP project billing instead of an AI Studio key. Not used by default.
#
# To switch to this mode:
#   1. Uncomment the two lines below and fill in your GCP project ID.
#   2. In src/main/resources/application.yml, uncomment the matching
#      `project-id` / `location` lines under BOTH spring.ai.google.genai AND
#      spring.ai.google.genai.embedding (they are separate connection blocks --
#      see the NOTE comments there).
#   3. Set up Application Default Credentials locally:
#        gcloud auth application-default login
#
GOOGLE_CLOUD_PROJECT_ID=dippatyo
GOOGLE_CLOUD_LOCATION=global


# ---------------------------------------------------------------------------------
# Reranker (M2 Milestone: Semantic Re-ranking)
#
# Second-stage cross-encoder / ranking model that re-scores candidate passages
# before LLM context assembly.
#
# Provider selection:
#   - 'noop'   : Default M0 baseline passthrough (leaves retrieval order untouched)
#   - 'vertex' : Google Cloud Vertex AI / Discovery Engine Ranking API (bills to GCP credits)
#   - 'local'  : Local HuggingFace Text Embeddings Inference (TEI) container
# ---------------------------------------------------------------------------------
RAG_RERANKER_PROVIDER=vertex

# Vertex AI Ranking API configuration:
# Model options:
#   - semantic-ranker-default-004 : Highest accuracy general reranker (recommended)
#   - semantic-ranker-fast-004    : Lower latency optimized tier
RAG_RERANKER_MODEL=semantic-ranker-default-004

# Note: Discovery Engine ranking configs reside in 'global', distinct from regional
# chat model endpoints (e.g. us-central1).
RAG_RERANKER_VERTEX_LOCATION=global
RAG_RERANKER_VERTEX_RANKING_CONFIG=default_ranking_config

# Local TEI container endpoint (used when RAG_RERANKER_PROVIDER=local):
# RAG_RERANKER_LOCAL_BASE_URL=http://localhost:8081
