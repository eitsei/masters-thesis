# ==============================================================================
# rag-evaluator Environment Configuration Template (Stage 1 + CSC Roihu vLLM)
# ==============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# Stage 1: Local Spring Boot RAG service URL (--judge none)
RAG_APP_URL=http://localhost:8080

# Stage 2: CSC Roihu HPC Workspace
CSC_PROJECT=<your-csc-project-id>
SCRATCH_BASE=/scratch/${CSC_PROJECT}/${USER}
HF_HOME=${SCRATCH_BASE}/huggingface_cache

# Stage 2: Co-located vLLM Judge Configuration (Qwen3.8-27B + BGE-M3)
JUDGE_PROVIDER=vllm
JUDGE_MODEL=qwen3.8-27b
JUDGE_EMBEDDING_MODEL=bge-m3
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
JUDGE_ENABLE_THINKING=0
JUDGE_MAX_TOKENS=2048
JUDGE_TIMEOUT=180.0
